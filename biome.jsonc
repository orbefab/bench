{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.git",
      "!**/dist",
      "!**/apps/desktop/app",
      "!**/apps/desktop/app.next",
      "!**/apps/desktop/app.prev",
      "!**/apps/desktop/release",
      "!**/apps/server/fixtures/external",
      // Recorded at full float precision; formatting would rewrite the baseline.
      "!**/apps/server/fixtures/arm-baseline.json",
      // Capture writes this as canonical JSON with 2-space indentation. Formatting it again would diverge from the tool.
      "!**/apps/server/catalog/snapshots",
      // cadgen writes this sidecar as one line. Formatting it would diverge from the generator.
      "!**/*.step.json",
      "!**/apps/docs/src/routeTree.gen.ts",
      "!**/apps/docs/worker-configuration.d.ts",
      "!**/apps/docs/public/brand/providers",
      "!**/pnpm-lock.yaml"
    ]
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 80,
    "attributePosition": "auto",
    "bracketSpacing": true
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on",
        "useSortedKeys": "off",
        "useSortedAttributes": "off",
        "useSortedInterfaceMembers": "off",
        "useSortedProperties": "off",
        "useSortedTypeFields": "off"
      }
    }
  },
  "linter": {
    "enabled": true,
    "domains": {
      "react": "recommended"
    },
    "rules": {
      "preset": "recommended",
      // Deferred: turning these on is a product rewrite (XR a11y, hook deps,
      // mesh `!` on typed arrays), not a formatter PR.
      "a11y": "off",
      "correctness": {
        "useExhaustiveDependencies": "off",
        "noInnerDeclarations": "off"
      },
      "security": {
        "noDangerouslySetInnerHtml": "off"
      },
      "style": {
        "noNonNullAssertion": "off"
      },
      "suspicious": {
        "noArrayIndexKey": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "arrowParentheses": "always",
      "bracketSameLine": false,
      "jsxQuoteStyle": "double",
      "quoteProperties": "asNeeded",
      "semicolons": "always",
      "trailingCommas": "es5"
    }
  },
  "css": {
    "formatter": {
      "enabled": true,
      "lineEnding": "lf",
      "lineWidth": 80,
      "quoteStyle": "double"
    },
    "parser": {
      "tailwindDirectives": true
    }
  },
  "json": {
    "formatter": {
      "enabled": true,
      "indentStyle": "space",
      "indentWidth": 2,
      "lineEnding": "lf",
      "lineWidth": 80,
      "trailingCommas": "none"
    }
  },
  "html": {
    "formatter": {
      "enabled": true
    }
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "overrides": [
    {
      "includes": [
        "**/*.{test,spec,selfcheck}.{ts,tsx,js,mjs}",
        "**/__tests__/**/*"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off",
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["**/scripts/**", "**/bin/**", "**/*.{mjs,cjs}"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/parts/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["node:*", "node:*/**"],
                    "message": "parts imports neither node nor an engine nor the server nor apps"
                  },
                  {
                    "group": [
                      "@sfab-bench/engine-*",
                      "@sfab-bench/engine-*/**",
                      "**/packages/engine-*/**"
                    ],
                    "message": "parts imports neither node nor an engine nor the server nor apps"
                  },
                  {
                    "group": [
                      "@sfab-bench/server",
                      "@sfab-bench/server/**",
                      "**/apps/**",
                      "apps/**"
                    ],
                    "message": "parts imports neither node nor an engine nor the server nor apps"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/engine-*/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["node:*", "node:*/**"],
                    "message": "an engine imports neither node nor parts nor the server nor apps"
                  },
                  {
                    "group": [
                      "@sfab-bench/parts",
                      "@sfab-bench/parts/**",
                      "**/packages/parts/**"
                    ],
                    "message": "an engine imports neither node nor parts nor the server nor apps"
                  },
                  {
                    "group": [
                      "@sfab-bench/server",
                      "@sfab-bench/server/**",
                      "**/apps/**",
                      "apps/**"
                    ],
                    "message": "an engine imports neither node nor parts nor the server nor apps"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@sfab-bench/parts",
                      "@sfab-bench/parts/**",
                      "@sfab-bench/engine-*",
                      "@sfab-bench/engine-*/**"
                    ],
                    "message": "the web client imports neither parts nor an engine"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "**/*.jsonc",
        "**/{tsconfig,jsconfig}.json",
        "**/tsconfig.*.json",
        ".vscode/*.json"
      ],
      "json": {
        "parser": {
          "allowComments": true,
          "allowTrailingCommas": true
        }
      }
    }
  ]
}
