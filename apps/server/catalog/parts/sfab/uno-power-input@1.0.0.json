{
  "format": "sfab.part@1",
  "id": "sfab/uno-power-input@1.0.0",
  "type": "power-input",
  "foreign": false,
  "sources": [
    {
      "title": "Arduino Uno Rev3 USB front end",
      "ref": "Arduino Uno Rev3 schematic, arduino.cc, CC-BY-SA (A000066). Rev3e bill arduino_Uno_Rev3-02-TH. F1 is MF-MSMF050, T1 is FDN340P, PC2 is 47 uF, C2 C4 C6 C7 are 100 nF on +5V"
    },
    {
      "title": "PC2 ESR",
      "ref": "Panasonic EEE-1EA470WP. tan delta 0.20 at 120 Hz, +20 C, so ESR = tan delta / (2 pi 120 C). PC1 is the same part on VIN. Ceramic ESR is not on the bill; assumed 0"
    },
    {
      "title": "VIN path",
      "ref": "Arduino Uno Rev3 schematic. VIN header to U1 (NCP1117ST50T3G) to +5V, with PC1 47 uF on VIN. M7, the 1N4007, is on the barrel jack only and is not between the VIN header and U1. U2 is LP2985-33 on +5V. U5A (LMV358) compares VIN through RN1A and RN1B, 10 kohm each, against 3V3, and drives T1's gate"
    }
  ],
  "axes": {
    "behaviour": {
      "1": {
        "default": "table",
        "variants": {
          "table": {
            "kind": "snapshot",
            "ref": "sfab/uno-power-input@1.0.0",
            "omits": [
              "fuse trip",
              "thermal state",
              "rail capacitance",
              "temperature"
            ]
          }
        }
      },
