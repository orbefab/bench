{
  "format": "sfab.part@1",
  "id": "sfab/battery-2s-lipo@1.0.0",
  "type": "battery",
  "foreign": false,
  "sources": [
    {
      "title": "Generic Li-ion open-circuit curve, two cells in series",
      "ref": "A graphite anode and a layered-oxide cathode: 3.0 V empty, 3.7 V nominal, 4.2 V full. Pack voltages are twice the cell, so 6.0 V empty, 7.4 V nominal, and 8.4 V full. The knots between those anchors follow that plateau and stay monotonic. They are not a trace from one cell's datasheet. vCutoff is 6.0 V. This pack is for VIN."
    },
    {
      "title": "Capacity and resistance, assumed",
      "ref": "Capacity 3600 C and rInternal 0.1 ohm are assumed for an example pack of that size."
    }
  ],
  "axes": {
    "behaviour": {
      "0": {
        "default": "ideal",
        "variants": {
          "ideal": {
            "kind": "form",
            "form": "ideal-voltage@1",
            "params": { "V": 8.4 },
            "omits": ["series resistance", "state of charge", "cutoff"]
          }
        }
      },
      "1": {
        "default": "pack",
        "variants": {
          "pack": {
            "kind": "form",
            "form": "battery@1",
            "params": {
              "ocv": [
                [0, 6],
                [0.05, 7],
                [0.1, 7.2],
                [0.2, 7.36],
                [0.3, 7.46],
                [0.4, 7.54],
                [0.5, 7.6],
                [0.6, 7.7],
                [0.7, 7.82],
                [0.8, 7.96],
                [0.9, 8.16],
                [1, 8.4]
              ],
              "rInternal": 0.1,
              "capacity": 3600,
              "soc0": 1,
              "vCutoff": 6
            },
            "omits": ["temperature", "Peukert", "relaxation", "aging"]
          }
        }
      }
    },
    "body": {
      "0": {
        "default": "none",
        "variants": {
          "none": { "kind": "none", "omits": ["pack body"] }
        }
      }
    },
    "visual": {
      "0": {
        "default": "box",
        "variants": {
          "box": {
            "kind": "box",
            "size": [0.07, 0.035, 0.02],
            "omits": ["cell shape"]
          }
        }
      }
    }
  }
}
