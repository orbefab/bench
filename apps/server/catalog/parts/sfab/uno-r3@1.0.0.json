{
  "format": "sfab.part@1",
  "id": "sfab/uno-r3@1.0.0",
  "type": "arduino-uno-r3",
  "foreign": false,
  "sources": [
    {
      "title": "Bench Uno and ATmega328P",
      "ref": "packages/contract/src/world.ts @ b5ce591"
    },
    {
      "title": "ATmega328P DC characteristics",
      "ref": "DS40002061: VIL max 0.3*Vcc, VIH min 0.6*Vcc, VOL max 0.9 V at 0.020 A, VOH min 4.2 V at -0.020 A, Vcc abs-max 6.0 V"
    },
    {
      "title": "ATmega328P 16 MHz speed grade",
      "ref": "DS40002061 Figure 33-1, Maximum Frequency vs. VCC. On the 2.7 V / 10 MHz to 4.5 V / 20 MHz segment, 16 MHz needs 3.78 V. Electrical characteristics list VCC up to 5.5 V. The 5V pin operating range is 3.78 V to 5.5 V. Absolute maximum stays 6 V."
    },
    {
      "title": "ATmega328P pin",
      "ref": "DS40002061 Figure 35-22 and Figure 35-24 at 25 C and VCC 5 V: Roh and Rol are the fitted resistances. Rpu is the midpoint of 20 kohm to 50 kohm. Input leakage is Iin 1 uA at 5 V, a 5 Mohm path to ground"
    }
  ],
  "axes": {
