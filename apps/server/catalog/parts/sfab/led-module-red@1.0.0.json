{
  "format": "sfab.part@1",
  "id": "sfab/led-module-red@1.0.0",
  "type": "led-module",
  "foreign": false,
  "sources": [
    {
      "title": "Red LED and series resistor",
      "ref": "220 ohm in series with sfab/led-red. The resistor sets the current; the LED is the Kingbright WP7113ID fit"
    }
  ],
  "axes": {
    "behaviour": {
      "1": {
        "default": "diode",
        "variants": {
          "diode": {
            "kind": "snapshot",
            "ref": "sfab/led-module-red@1.0.0",
            "omits": ["temperature", "colour", "capacitance"]
          }
        }
      },
      "2": {
        "default": "netlist",
        "variants": {
          "netlist": {
            "kind": "composite",
            "omits": ["temperature", "colour"],
            "netlist": {
              "instances": {
                "r": {
                  "part": "sfab/resistor@1.0.0",
                  "params": {
                    "R": 220
                  }
                },
                "led": {
                  "part": "sfab/led-red@1.0.0"
                }
              },
              "wires": [["r.B", "led.A"]],
              "expose": {
                "IN": "r.A",
                "GND": "led.K"
              }
            }
          }
        }
      }
    },
    "body": {
      "0": {
        "default": "none",
        "variants": {
          "none": {
            "kind": "none",
            "omits": ["package body"]
          }
        }
      }
    },
    "visual": {
      "0": {
        "default": "form",
        "variants": {
          "box": {
            "kind": "box",
            "size": [0.01, 0.005, 0.008],
            "omits": ["lens", "leads"]
          },
          "form": {
            "kind": "form",
            "form": "lens@1",
            "size": [0.01, 0.005, 0.008],
            "params": {
              "color": "red",
              "board": "#1f6f43"
            },
            "omits": ["resistor", "header pins", "glow with current"]
          }
        }
      }
    }
  }
}
