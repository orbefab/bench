{
  "format": "sfab.part@1",
  "id": "sfab/nano-ch340@1.0.0",
  "type": "arduino-nano",
  "foreign": false,
  "sources": [
    {
      "title": "Arduino Nano 3.x pinout",
      "ref": "docs.arduino.cc/hardware/nano: D0-D13, A0-A7, 5V, 3V3, GND, VIN, RESET; PWM on D3, D5, D6, D9, D10, D11; A6 and A7 are analog input only; board 45 mm by 18 mm"
    },
    {
      "title": "ATmega328P DC characteristics",
      "ref": "DS40002061: same logic ratings and brownout as the Uno. Active supply 0.010 A at 5 V and 16 MHz, read from the active-current figure"
    },
    {
      "title": "CH340G",
      "ref": "WCH CH340 datasheet: USB working current 0.012 A"
    },
    {
      "title": "Power LED",
      "ref": "Arduino Nano Rev 3.2 schematic, NanoV3.2.sch: RP1 is a 1 kohm pack (CAY16-102J4LF), and element C is from +5V to the power LED. The clone is assumed to match. Forward drop 1.8 V assumed, so 0.0032 A at 5 V"
    },
    {
      "title": "USB diode S4",
      "ref": "Vishay SS12-SS14, document 88746, Fig. 3. The clone marks this diode S4. No polyfuse and no P-MOSFET"
    },
    {
      "title": "C106",
      "ref": "A part marked C106, most likely a 10 uF / 16 V tantalum, placed on +5V after the diode. Position assumed. ESR 5 ohm assumed, inside the 4-8 ohm maxima of a case-A part of that rating (Kemet T491, AVX TAJ)"
    },
    {
      "title": "D13 LED resistor",
      "ref": "1 kohm assumed. The resistor code on the board is unknown"
    },
    {
      "title": "D13 input leakage",
      "ref": "DS40002061 Iin 1 uA max. A 5 Mohm resistor from D13 to ground, so the LED node has a DC path while the pin is an input"
    },
    {
      "title": "Reset network",
      "ref": "Nano Rev 3.2 schematic, NanoV3.2.sch: C4 is 100 nF from DTR to RESET, and the pull-up is RP1 at 1 kohm. The clone is assumed to match. DTR idle high is the +5V node"
    },
    {
      "title": "ATmega328P pin",
      "ref": "DS40002061 Figure 35-22 and Figure 35-24 at 25 C and VCC 5 V: Roh and Rol are the fitted resistances. Rpu is the midpoint of 20 kohm to 50 kohm. Input leakage is Iin 1 uA at 5 V, a 5 Mohm path to ground"
    }
  ],
